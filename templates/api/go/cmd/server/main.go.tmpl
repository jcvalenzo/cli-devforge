package main

import (
	"fmt"
	"log"
	"net/http"

	"{{.ModulePath}}/internal/handler"
)

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handler.Health)
	mux.HandleFunc("GET /api/v1/{{.ProjectName}}", handler.List)
	mux.HandleFunc("POST /api/v1/{{.ProjectName}}", handler.Create)

	addr := ":8080"
	fmt.Printf("API %s listening on %s\n", "{{.FullName}}", addr)
	log.Fatal(http.ListenAndServe(addr, mux))
}
