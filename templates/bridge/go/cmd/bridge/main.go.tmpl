package main

import (
	"fmt"
	"log"
	"os"
	"os/signal"
	"syscall"
)

func main() {
	fmt.Println("Bridge {{.FullName}} started")

	source := "{{.ProjectName}}-source"
	target := "{{.ProjectName}}-target"
	sigCh := make(chan os.Signal, 1)
	signal.Notify(sigCh, syscall.SIGINT, syscall.SIGTERM)

	go func() {
		for {
			// TODO: Implement bridging logic between systems/brokers
			fmt.Printf("Bridging %s -> %s\n", source, target)
		}
	}()

	sig := <-sigCh
	fmt.Printf("Received %s, shutting down...\n", sig)
}
