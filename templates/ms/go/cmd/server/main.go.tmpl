package main

import (
	"fmt"
	"log"
	"net/http"

	"{{.ModulePath}}/internal/handler"
)

func main() {
	http.HandleFunc("/health", handler.Health)
	http.HandleFunc("/ready", handler.Ready)

	addr := ":8080"
	fmt.Printf("Microservice %s listening on %s\n", "{{.FullName}}", addr)
	log.Fatal(http.ListenAndServe(addr, nil))
}
